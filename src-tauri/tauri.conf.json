{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "及时提醒",
  "version": "2.3.1",
  "identifier": "com.jishi.reminder",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "及时提醒",
        "url": "index.html",
        "width": 1100,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
